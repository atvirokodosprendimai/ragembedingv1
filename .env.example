# ragembedingv1 gateway configuration.
# Copy to .env and adjust. Real environment variables override these values.

# --- Gateway ---
# HTTP bind address for the gateway itself.
LISTEN_ADDR=:8080
# SQLite database path (pure-Go driver, no cgo). Holds API keys and usage events.
DB_PATH=ragembed.db
# Single upstream the gateway forwards every embedding request to.
# Caddy listens here and load-balances across the 10 Ollama backends.
CADDY_UPSTREAM_URL=http://localhost:11435
# Embedding model name recorded alongside token usage.
EMBED_MODEL=bge-m3
# Published on the public landing page as the address to request an API key at.
CONTACT_EMAIL=info@ituoga.lt
# Published next to the email, in international form (it becomes a tel: link).
CONTACT_PHONE=+37063594444
# The operator's own site. Linked from the public pages and named as the
# article's publisher in structured data.
COMPANY_URL=https://letas.lt

# --- Per-token defaults (each overridable per key via `ragctl create`) ---
# Max number of inputs allowed in one /v1/embeddings request.
DEFAULT_BATCH_MAX=25
# Max requests per minute per key. Exceeding it returns 429 + Retry-After.
# This is also the figure the published plan sells, so raising it here without
# raising it on the page means new keys quietly get more than was advertised.
DEFAULT_RATE_PER_MIN=100
# Token budget for a key:
#   -1        = unlimited (on-demand)
#   >0        = prepaid allowance in bge-m3 input tokens (e.g. 100000000 for 100M)
DEFAULT_TOKEN_BUDGET=-1
# How the budget is scoped:
#   monthly   = allowance resets at each calendar-month boundary
#   lifetime  = cumulative, never resets
DEFAULT_BUDGET_PERIOD=lifetime
# Admission-queue rank a new key is issued with: 0 = free/normal, up to 9 for
# front-of-house traffic that must never queue behind batch jobs.
DEFAULT_PRIORITY=0

# --- Published price ---
# The monthly price shown on the landing page, in the article and in llms.txt,
# and emitted as a schema.org Offer. Quoted excluding VAT, the way Lithuanian
# B2B prices are; the VAT-inclusive figure is derived from the rate below.
PLAN_PRICE_EUR=50
# Lithuanian PVM rate. Set to 0 if the operator is not VAT registered — the
# pages then drop the "+ PVM" wording and the inclusive figure entirely rather
# than printing a 0% that says nothing.
PLAN_VAT_PERCENT=21

# --- Operator dashboard (Basic auth) ---
# The dashboard lists every key, its limits and its spend, so it is NOT served
# until a password is set. Leaving DASHBOARD_PASSWORD empty disables the UI
# entirely; the embeddings API is unaffected either way.
# Basic auth sends the credential on every request, base64-encoded and NOT
# encrypted — put TLS in front of the gateway if it is reachable from anywhere
# but localhost.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Admission queue (keeps the main site off the back of a batch flood) ---
# How many requests may be in flight upstream at once. Match it to what the pool
# behind Caddy can actually chew through — one slot per Ollama backend.
UPSTREAM_MAX_CONCURRENT=10
# How long a request may sit in the queue before it is admitted ahead of
# higher-priority work. This is the anti-starvation valve: free traffic always
# drains within roughly this long, however busy the priority key is.
QUEUE_PROMOTE_AFTER=5s
