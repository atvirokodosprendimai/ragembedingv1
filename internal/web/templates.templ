package web

// Page renders the full dashboard document. The terminal/data-ops aesthetic is
// deliberate and single-look (dark phosphor), so there is no light theme: it is
// an operator tool, not a public site.
templ Page(vm PageVM) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>ragembed · token usage</title>
			// The version is spelled out rather than pasted: an "@v1.0.2" suffix looks
			// like an email address to Cloudflare's obfuscator, which silently rewrote
			// this URL to "[email protected]" once — the script 400'd and the whole
			// dashboard lost its interactivity with no visible error.
			<script type="module" src={ datastarCDN }></script>
			<link rel="stylesheet" href={ BasePath + "/assets/dashboard.css" }/>
		</head>
		<body>
			<div class="wrap" data-signals={ vm.SignalsInit }>
				<header class="masthead">
					<div class="brand">
						<span class="prompt">▉</span>
						<span class="brand-name">ragembed</span>
						<span class="brand-sub">token usage</span>
					</div>
					<div class="meta">
						<span class="chip" title="embedding model">{ vm.Model }</span>
						<span class="stat"><b>{ intStr(vm.TotalKeys) }</b> keys</span>
						<span class="stat"><b class="amber">{ vm.TokensTodayLabel }</b> tokens today</span>
					</div>
				</header>
				if vm.HasKeys {
					<section
						class="panel pressure"
						aria-label="Upstream pool pressure"
						data-indicator:_queueSync
						data-on-interval__duration.5s={ "$_queueLive && @get('" + BasePath + "/queue')" }
					>
						<div class="panel-head pressure-head">
							<span><span class="tick">┌─</span> pool pressure</span>
							<span class="pressure-actions">
								<span class="live" data-show="$_queueLive" style="display:none">● live</span>
								<span class="loading" data-show="$_queueSync" style="display:none" aria-hidden="true">syncing</span>
								<button
									type="button"
									class="ghost"
									aria-label="Toggle live pool updates"
									data-attr:aria-pressed="$_queueLive"
									data-on:click="$_queueLive = !$_queueLive"
									data-text="$_queueLive ? '❚❚ pause' : '▶ resume'"
								>❚❚ pause</button>
							</span>
						</div>
						@QueuePanel(vm.Queue)
					</section>
					<main class="grid">
						<nav class="panel keys" aria-label="API keys">
							<div class="panel-head">
								<span class="tick">┌─</span> tokens · by key
							</div>
							<ul class="keylist" role="list">
								for _, k := range vm.Keys {
									<li>
										@keyRow(k)
									</li>
								}
							</ul>
						</nav>
						<section
							class="panel detailcol"
							data-on-interval__duration.30s={ "$selectedKey && @get('" + BasePath + "/keys/' + $selectedKey)" }
						>
							@Detail(*vm.Detail)
						</section>
					</main>
				} else {
					@emptyState()
				}
				<footer class="foot">
					<span>bge-m3 tokens counted from upstream <code>usage.prompt_tokens</code></span>
					<span class="faint">keys are issued with <code>ragctl create</code></span>
				</footer>
			</div>
		</body>
	</html>
}

// QueuePanel is the live admission-queue strip: how contended the Ollama pool is
// right now, who is waiting for it, and whether anyone has waited long enough to
// be promoted past the priority order. Its root carries id="queue" so datastar
// morphs it in place on each poll, and the same component renders both the first
// paint and the SSE fragment — one source of truth for the layout.
templ QueuePanel(q QueueVM) {
	<div id="queue" class={ "queue", templ.KV("hot", q.Saturated), templ.KV("aged", q.Aged) }>
		<div class="queue-slots">
			<span class="queue-label">slots</span>
			<span class="slots" role="img" aria-label={ q.InFlightLabel + " upstream slots busy" }>
				for _, busy := range q.Slots {
					<span class={ "slot", templ.KV("busy", busy) }></span>
				}
			</span>
			<span class="queue-num num">{ q.InFlightLabel }</span>
		</div>
		if q.Waiting {
			<div class="queue-classes" role="list" aria-label="Queued requests by priority">
				for _, c := range q.Classes {
					<div class="qclass" role="listitem">
						<span class={ "qtag", templ.KV("top", c.Top), templ.KV("aged", c.Aged) }>{ c.Label }</span>
						<span class="qbar" aria-hidden="true">
							<span class="qfill" style={ "width:" + c.Width }></span>
						</span>
						<span class="qcount num">{ c.CountLabel }</span>
						<span class="qwait num faint">{ c.WaitLabel }</span>
					</div>
				}
			</div>
		} else if q.Idle {
			<p class="queue-note faint">pool idle — nothing in flight, nothing queued</p>
		} else {
			<p class="queue-note faint">no queue — every request is admitted straight through</p>
		}
		<div class="queue-foot">
			<span>
				{ q.WaitingLabel }
				if q.Waiting {
					· oldest <b class="num">{ q.OldestLabel }</b>
				}
			</span>
			if q.Aged {
				<span class="promo-note">↑ waited past { q.PromoteLabel } — promoting ahead of priority</span>
			}
			<span class="faint">
				admitted <b class="num">{ q.AdmittedLabel }</b> · promoted <b class="num">{ q.PromotedLabel }</b>
			</span>
		</div>
	</div>
}

// keyRow is one selectable key in the sidebar. It is a real <button> so it is
// keyboard-reachable and focusable; datastar drives selection and the fetch.
templ keyRow(k KeyListItem) {
	<button
		type="button"
		class="keyrow"
		data-on:click={ k.OnClick }
		data-indicator:_fetching
		data-class:active={ k.ActiveExpr }
		aria-label={ "View usage for " + k.Label }
	>
		<span class="row-top">
			<span class={ "dot", k.StatusClass } aria-hidden="true"></span>
			<span class="row-label">{ k.Label }</span>
			if k.Elevated {
				<span class="tag-prio" title="admission-queue rank">{ k.PrioLabel }</span>
			}
			if k.Revoked {
				<span class="tag-revoked">revoked</span>
			}
			<span class="row-today num">{ k.TodayLabel }</span>
		</span>
		<span class="bar" aria-hidden="true">
			<span class="bar-fill" style={ "width:" + k.Width }></span>
		</span>
	</button>
}

// Detail is the selected key's panel. Its root carries id="detail" so datastar
// morphs it in place; the same component renders both inline and as the SSE
// fragment, so there is a single source of truth for the layout.
templ Detail(d DetailVM) {
	<div id="detail" class="detail" data-class:loading="$_fetching">
		<div class="detail-head">
			<div>
				<h2 class="detail-title">
					{ d.Label }
					if d.Revoked {
						<span class="tag-revoked">revoked</span>
					}
				</h2>
				<div class="detail-id faint">id { uintStr(d.ID) }</div>
			</div>
			<div class="detail-actions">
				<span class="loading" data-show="$_fetching" style="display:none" aria-hidden="true">● syncing</span>
				<button type="button" class="ghost" data-on:click={ d.RefreshExpr } aria-label="Refresh usage">↻ refresh</button>
			</div>
		</div>
		<dl class="limits">
			@limit("batch", d.Batch, "inputs/req", false)
			@limit("rate", d.Rate, "req/min", false)
			@limit("prio", d.Prio, "in queue", d.Elevated)
			@limit("budget", d.BudgetLabel, "tokens", false)
			@limit("period", d.Period, "", false)
		</dl>
		<div class="buckets" role="group" aria-label="Token usage by period">
			for _, b := range d.Buckets {
				<div class={ "bucket", templ.KV("emph", b.Emphasis) }>
					<span class="bucket-label">{ b.Label }</span>
					<span class="bucket-bar" aria-hidden="true">
						<span class="bucket-fill" style={ "width:" + b.Width }></span>
					</span>
					<span class="bucket-num num">{ b.TokensLabel }</span>
				</div>
			}
		</div>
		if d.HasBudget {
			<div class={ "meter", templ.KV("over", d.Over) }>
				<div class="meter-head">
					<span class="bucket-label">{ d.Period } budget</span>
					<span class="num">
						<b>{ d.BudgetUsedLabel }</b> used · { d.BudgetRemainingLabel } left
					</span>
				</div>
				<div
					class="meter-track"
					role="progressbar"
					aria-label="budget consumed"
					aria-valuemin="0"
					aria-valuemax="100"
				>
					<div class="meter-fill" style={ "width:" + d.BudgetWidth }></div>
				</div>
				if d.Over {
					<div class="over-note">budget exhausted — requests return 402 until { d.Period } resets</div>
				}
			</div>
		}
	</div>
}

// limit renders one key limit as a compact stat. accent marks a value worth
// noticing at a glance (a key promoted above the free tier), so the reader's eye
// lands on what makes this key different rather than on every stat equally.
templ limit(label, value, unit string, accent bool) {
	<div class={ "limit", templ.KV("accent", accent) }>
		<dt>{ label }</dt>
		<dd class="num">
			{ value }
			if unit != "" {
				<span class="unit">{ unit }</span>
			}
		</dd>
	</div>
}

// detailError replaces the detail panel with an error message. It keeps the
// id="detail" root so datastar morphs it into the same slot, and (per the
// datastar convention) is served with a 200, not an HTTP error status.
templ detailError(msg string) {
	<div id="detail" class="detail">
		<div class="detail-head">
			<h2 class="detail-title">— error —</h2>
		</div>
		<p class="over-note" style="margin-top:16px">{ msg }</p>
	</div>
}

// emptyState is shown when no keys exist yet.
templ emptyState() {
	<main class="empty">
		<div class="empty-box">
			<div class="empty-glyph">▉ _</div>
			<h2>no keys yet</h2>
			<p class="faint">Mint one from the CLI, then reload:</p>
			<code class="empty-cmd">ragctl create --name my-app</code>
		</div>
	</main>
}
