package web

// Landing is the public API documentation page, in Lithuanian: the service is
// run for a Lithuanian audience, and the people who ask for a key read the page
// before they read the code. It carries no client-side runtime at all — no
// datastar, no fetches — because its entire job is to be readable the instant it
// arrives; there is nothing here to make reactive.
//
// The prose is translated; the code samples, HTTP headers and status numbers are
// not. Those are the parts a developer copies verbatim, and translating them
// would break them.
templ Landing(vm LandingVM) {
	<!DOCTYPE html>
	<html lang="lt">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>ragembed · embeddingų API lietuviškiems tekstams</title>
			<meta
				name="description"
				content={ "OpenAI suderinamas embeddingų API su " + vm.Model + " modeliu. Jūsų serveriuose, su savo raktu ir limitais — tekstai neišeina iš jūsų infrastruktūros." }
			/>
			<link rel="canonical" href={ templ.SafeURL(vm.BaseURL + "/") }/>
			<meta property="og:type" content="website"/>
			<meta property="og:title" content="ragembed · embeddingų API lietuviškiems tekstams"/>
			<meta
				property="og:description"
				content="OpenAI suderinamas embeddingų API. Tekstai neišeina iš jūsų infrastruktūros."
			/>
			<meta property="og:url" content={ vm.BaseURL + "/" }/>
			<meta property="og:locale" content="lt_LT"/>
			<link rel="stylesheet" href="/assets/landing.css"/>
		</head>
		<body>
			<div class="page">
				<header class="top">
					<div class="brand">
						<span class="prompt" aria-hidden="true">▉</span>
						<span class="brand-name">ragembed</span>
					</div>
					<span class="chip">{ vm.Model }</span>
				</header>
				<main>
					<section class="hero">
						<h1>Tekstas įeina, vektoriai išeina.</h1>
						<p class="lede">
							Su OpenAI suderinamas embeddingų API, paremtas <b>{ vm.Model }</b> modeliu.
							Nukreipkite bet kurį OpenAI klientą į šį adresą, siųskite tekstų paketą
							ir atgausite vektorius. Jūsų raktas turi savo limitus ir savo tokenų
							biudžetą.
						</p>
						<div class="endpoint" role="group" aria-label="Bazinis adresas">
							<span class="endpoint-label">bazinis adresas</span>
							<code class="endpoint-url">{ vm.BaseURL }</code>
						</div>
					</section>
					<section aria-labelledby="pradzia">
						<h2 id="pradzia"><span class="tick">01</span> Greita pradžia</h2>
						<p>Viena užklausa, vienas vektorius. Įrašykite raktą, kurį jums išdavė operatorius.</p>
						@code(`curl ` + vm.BaseURL + `/v1/embeddings \
  -H "Authorization: Bearer sk-rag-…" \
  -H "Content-Type: application/json" \
  -d '{"model":"` + vm.Model + `","input":"labas rytas"}'`)
					</section>
					<section aria-labelledby="paketai">
						<h2 id="paketai"><span class="tick">02</span> Paketinis apdorojimas</h2>
						<p>
							Siųskite masyvą ir apdorosite iki <b>{ vm.BatchMax }</b> tekstų viena
							užklausa — daug greičiau nei po vieną. Viršijus limitą užklausa
							atmetama su <code>400</code>, o ne tyliai apkarpoma.
						</p>
						@code(`curl ` + vm.BaseURL + `/v1/embeddings \
  -H "Authorization: Bearer sk-rag-…" \
  -H "Content-Type: application/json" \
  -d '{"model":"` + vm.Model + `","input":["pirmas tekstas","antras tekstas","trečias tekstas"]}'`)
						<p class="note">
							Vektoriai grįžta <b>ta pačia tvarka, kuria juos išsiuntėte</b>, todėl
							galite iš karto priskirti juos savo įrašams.
						</p>
					</section>
					<section aria-labelledby="native">
						<h2 id="native"><span class="tick">03</span> Natyvus Ollama adresas</h2>
						<p>
							Jei jūsų klientas kalba su Ollama, o ne su OpenAI, naudokite
							<code>/api/embed</code>. Tas pats raktas, tie patys limitai, tie patys
							paketai — skiriasi tik atsakymo struktūra.
						</p>
						@code(`curl ` + vm.BaseURL + `/api/embed \
  -H "Authorization: Bearer sk-rag-…" \
  -H "Content-Type: application/json" \
  -d '{"model":"` + vm.Model + `","input":["pirmas tekstas","antras tekstas"]}'`)
					</section>
					<section aria-labelledby="sdk">
						<h2 id="sdk"><span class="tick">04</span> Su OpenAI SDK</h2>
						<p>Atskiro kliento nereikia — pakeiskite bazinį adresą ir dirbkite toliau.</p>
						@code(`from openai import OpenAI

client = OpenAI(base_url="` + vm.BaseURL + `/v1", api_key="sk-rag-…")

vektoriai = client.embeddings.create(
    model="` + vm.Model + `",
    input=["pirmas tekstas", "antras tekstas"],
)
print(len(vektoriai.data), "vektoriai")`)
					</section>
					<section aria-labelledby="limitai">
						<h2 id="limitai"><span class="tick">05</span> Ką leidžia jūsų raktas</h2>
						<div class="limits">
							<div class="limit">
								<dt>paketas</dt>
								<dd>{ vm.BatchMax } <span class="unit">tekstai / užklausa</span></dd>
							</div>
							<div class="limit">
								<dt>dažnis</dt>
								<dd>{ vm.RatePerMin } <span class="unit">užklausos / min.</span></dd>
							</div>
							<div class="limit">
								<dt>biudžetas</dt>
								<dd>pagal raktą <span class="unit">tokenai</span></dd>
							</div>
						</div>
						<p class="note">
							Tai numatytieji limitai naujam raktui; jūsų gali skirtis — juos nustato
							operatorius kiekvienam raktui atskirai. Kiekvienas atsakymas raktui su
							biudžetu turi <code>X-Token-Budget-Remaining</code> antraštę, todėl
							savo sunaudojimą matote patys, nieko neklausdami.
						</p>
					</section>
					<section aria-labelledby="kaina">
						<h2 id="kaina"><span class="tick">06</span> Kiek kainuoja</h2>
						<p>
							Vienas planas ir viena suma per mėnesį. Mokesčio už tokeną nėra, todėl
							perindeksavimas — dažniausia išlaidų staigmena vektorinėse sistemose —
							sąskaitos nekeičia.
						</p>
						@planCard(vm)
						<p class="note">
							Sąskaita išrašoma mėnesiui. Jei reikia didesnio dažnio ar didesnių
							paketų, parašykite — limitai nustatomi kiekvienam raktui atskirai.
						</p>
					</section>
					<section aria-labelledby="apkrova">
						<h2 id="apkrova"><span class="tick">07</span> Kai serveris apkrautas</h2>
						<p>
							Užklausos rikiuojamos į eilę, o ne atmetamos. Esant apkrovai jūsų
							užklausa laukia laisvos vietos, o ne krenta su klaida — staigus
							srautas virsta ilgesniu atsakymo laiku, o ne klaidų lavina, todėl
							kartoti užklausų nereikia. Niekas nelieka pamirštas: ilgiau laukusi
							užklausa praleidžiama pirmiau už aukštesnio prioriteto srautą.
						</p>
					</section>
					<section aria-labelledby="kodai">
						<h2 id="kodai"><span class="tick">08</span> Ką reiškia atsakymų kodai</h2>
						<div class="table-scroll">
							<table class="statuses">
								<thead>
									<tr>
										<th scope="col">Kodas</th>
										<th scope="col">Reikšmė</th>
										<th scope="col">Ką daryti</th>
									</tr>
								</thead>
								<tbody>
									for _, s := range vm.Statuses {
										<tr>
											<th scope="row"><span class={ "code", s.Tone }>{ s.Code }</span></th>
											<td>{ s.Meaning }</td>
											<td class="dim">{ s.Action }</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
						<p class="note">
							Klaidos grąžinamos OpenAI formatu
							(<code>{ `{"error":{"message","type"}}` }</code>), todėl OpenAI SDK
							apdoroja jas įprastu būdu.
						</p>
					</section>
					<section aria-labelledby="raktas">
						<h2 id="raktas"><span class="tick">09</span> Kaip gauti raktą</h2>
						<p>
							Raktus išduoda operatorius — savitarnos registracijos nėra. Parašykite
							mums ir trumpai nurodykite, kiek maždaug tekstų planuojate apdoroti,
							kad paketo, dažnio ir biudžeto limitai būtų nustatyti prasmingai.
						</p>
						@contactLinks(vm.Contact)
						<p class="note">
							Raktą laikykite paslaptyje: saugoma tik jo maiša (hash), todėl pamesto
							rakto atkurti neįmanoma — tik išduoti naują.
						</p>
					</section>
					<section aria-labelledby="daugiau">
						<h2 id="daugiau"><span class="tick">10</span> Nesate tikri, ar jums to reikia?</h2>
						<p>
							Parašėme išsamų straipsnį apie tai, kas yra embeddingai, kada jų verta
							imtis, kada tikrai neverta, ir ką daryti su asmens duomenimis pagal
							BDAR.
						</p>
						<p>
							<a class="mailto" href={ templ.SafeURL(articlePath) }>
								<span class="tick" aria-hidden="true">→</span>
								Kada jūsų įmonei reikia embeddingų API
							</a>
						</p>
					</section>
				</main>
				<footer class="foot">
					<span>
						{ vm.Model } embeddingai ·
						<a class="admin-link" href={ templ.SafeURL(vm.Contact.CompanyURL) }>{ vm.Contact.CompanyName }</a>
					</span>
					<a class="admin-link" href={ templ.SafeURL(vm.AdminPath) }>operatoriaus skydelis →</a>
				</footer>
			</div>
		</body>
	</html>
}

// planCard renders the offer: the price, and the three limits it buys.
//
// There is one plan, so there is no grid of tiers to compare — a card row would
// be borrowed furniture. It is laid out as a receipt instead, which is both
// honest about the product and native to the terminal voice of the rest of the
// page.
//
// The three included limits are the same values section 05 documents, restated
// here in buyer's language. That repetition is deliberate: a reader who scrolls
// to the price should not have to scroll back to learn what the price is for.
// Both readings come from the same view model, so they cannot disagree.
templ planCard(vm LandingVM) {
	<div class="plan">
		<p class="plan-eyebrow">vienas planas</p>
		<p class="plan-price">
			<span class="plan-figure">{ vm.Plan.PriceExVAT }&nbsp;€</span>
			if vm.Plan.HasVAT() {
				<span class="plan-vat">+ PVM</span>
			}
			<span class="plan-period">/ mėn.</span>
		</p>
		if vm.Plan.HasVAT() {
			// The figure that actually lands on the invoice. A reader who cannot
			// reclaim VAT should not have to do the multiplication to find out
			// what they will be charged.
			<p class="plan-incl">{ vm.Plan.PriceIncVAT } € su PVM ({ vm.Plan.VATLabel })</p>
		}
		<ul class="plan-includes">
			<li><b>Tokenai — { vm.TokenBudget }</b>. Mokesčio už apdorotą tokeną nėra.</li>
			<li><b>{ vm.RatePerMin } užklausos per minutę</b> vienam raktui.</li>
			<li><b>{ vm.BatchMax } tekstai vienoje užklausoje</b> — paketais, ne po vieną.</li>
		</ul>
		<p class="plan-cta">
			<a class="mailto" href="#raktas">
				<span class="tick" aria-hidden="true">→</span>
				Kaip gauti raktą
			</a>
		</p>
	</div>
}

// contactLinks renders the ways to reach a human. Email and phone sit together
// because people differ in which one they will actually use, and both are real
// links: a tel: on a phone dials, and on a desktop it is still readable.
templ contactLinks(c Contact) {
	<p class="contact-row">
		<a class="mailto" href={ templ.SafeURL("mailto:" + c.Email + "?subject=ragembed%20API%20raktas") }>
			<span class="tick" aria-hidden="true">✉</span>
			{ c.Email }
		</a>
		<a class="mailto" href={ templ.SafeURL("tel:" + c.Phone) }>
			<span class="tick" aria-hidden="true">☎</span>
			{ c.PhoneLabel }
		</a>
	</p>
}

// code renders one copy-pasteable block. The <pre> scrolls on its own so a long
// curl line never makes the whole page scroll sideways on a phone.
templ code(body string) {
	<div class="code-scroll">
		<pre><code>{ body }</code></pre>
	</div>
}
